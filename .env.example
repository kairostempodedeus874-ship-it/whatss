# Copie para ".env" e preencha. NUNCA envie este arquivo para o GitHub.

# Porta HTTP (a hospedagem normalmente injeta sozinha)
PORT=3001

# Senha do servidor — o painel usa a mesma
WPP_API_KEY=troque-por-uma-chave-forte

# Mesma chave configurada na função wpp-agente do Backend
WPP_AGENT_SECRET=troque-por-uma-chave-forte

# Endereço do Backend
SUPABASE_URL=https://SEU-BACKEND-AQUI
SUPABASE_ANON_KEY=sua-chave-publica

# Opcional, mas recomendada (dá acesso completo ao banco)
# SUPABASE_SERVICE_KEY=sua-chave-de-servico

# Pasta da sessão do WhatsApp — PRECISA ficar dentro do volume persistente
WPP_AUTH_DIR=/data/wpp-auth

# URL pública do serviço (detectada automaticamente no Fly/Render/Railway)
# WPP_PUBLIC_URL=https://seu-servico.fly.dev

# Fuso horário para os agendamentos
TZ=America/Sao_Paulo